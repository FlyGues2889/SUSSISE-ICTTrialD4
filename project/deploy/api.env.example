# 后端环境变量示例，复制到 /etc/d4/api.env
# 内网地址请用 RDS / DCS 的内网 IP，不要暴露公网端口

DB_HOST=192.168.1.10
DB_PORT=3306
DB_USER=d4_app
DB_PASS=change-me
DB_NAME=sedentary_health

# 必须替换为随机串：python3 -c "import secrets;print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me

# 可选：配置后启用 Redis 缓存；留空则自动降级为进程内缓存
# REDIS_URL=redis://:password@192.168.1.11:6379/0
REDIS_URL=
# 可选：问答兜底 AI。未配置时问答只用本地知识库，低置信度返回固定拒答文案
# AI_PROVIDER 取 huawei 时才会调用；接口需兼容 OpenAI Chat Completions 协议
AI_PROVIDER=none
# 华为云盘古 / ModelArts 推理服务的对话补全地址
HUAWEI_AI_ENDPOINT=
HUAWEI_AI_TOKEN=
HUAWEI_AI_MODEL=pangu
AI_TIMEOUT=15